# Copy to .env and fill in the values:  cp .env.example .env
# .env is git-ignored and must be created on every machine that runs the app.

# --- Database -----------------------------------------------------------------
# Control database (users, roles, tenants). Each tenant then gets its own
# database, created automatically from the admin UI.
# With Docker Compose leave it unset: it defaults to the bundled MySQL service.
# CONTROL_DB_URL=mysql+mysqlconnector://user:password@localhost:3306/clasificador_control
# SQLite works for quick local experiments (tenant creation needs MySQL):
# CONTROL_DB_URL=sqlite:///./control.db

# Root password of the bundled MySQL container (Docker Compose only).
MYSQL_ROOT_PASSWORD=root

# Legacy single-tenant database; only used as --db-url by the scripts/ tools.
# DB_URL=mysql+mysqlconnector://user:password@localhost:3306/clasificador_cdr_whatsapp

# --- Web app --------------------------------------------------------------------
# Signs the session cookie. Required in production (gunicorn refuses to start without it).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google OAuth. Register http://<host>:<FLASK_PORT>/api/auth/google/callback as an
# authorized redirect URI in Google Cloud Console (one per host you use).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the network (required in Docker).
FLASK_HOST=127.0.0.1
FLASK_PORT=5050

# --- AI layer (optional) ------------------------------------------------------------
# Without a key, rule-based classification still works and gray-zone
# conversations stay pending until a key is configured.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Frontend dev server (npm run dev) only ---------------------------------------
VITE_PORT=5173
# Extra hostnames allowed to reach the Vite dev server, comma-separated.
# VITE_ALLOWED_HOSTS=my-pc.lan.example.com
